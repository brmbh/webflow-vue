{
  "name": "webflow-vue",
  "version": "0.2.0",
  "type": "module",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "vite": "^5.4.0",
    "vite-plugin-mkcert": "^1.17.8",
    "vitest": "^2.1.9",
    "vue": "^3.5.15"
  },
  "description": "Vue 3 islands on Webflow-rendered DOM \u2014 mount, shared state, and CMS parsing, with no build step required.",
  "license": "MIT",
  "author": "Jan Brombach",
  "homepage": "https://github.com/brmbh/webflow-vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brmbh/webflow-vue.git"
  },
  "keywords": [
    "webflow",
    "vue",
    "islands",
    "no-code",
    "cms",
    "hybrid",
    "agentic"
  ],
  "main": "./dist/webflow-vue.esm.js",
  "module": "./dist/webflow-vue.esm.js",
  "unpkg": "./dist/webflow-vue.global.js",
  "jsdelivr": "./dist/webflow-vue.global.js",
  "exports": {
    ".": {
      "import": "./dist/webflow-vue.esm.js",
      "default": "./dist/webflow-vue.global.js"
    }
  },
  "files": [
    "bin",
    "dist/webflow-vue.global.js",
    "dist/webflow-vue.esm.js",
    "src/cli",
    "templates",
    "skills",
    "skills.sh.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:lib": "vite build --mode lib",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "bin": {
    "webflow-vue": "bin/webflow-vue.js"
  }
}
